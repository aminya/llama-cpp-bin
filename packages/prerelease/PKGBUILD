  pkgdesc='Official llama.cpp prerelease Vulkan backend'
  provides=('llama-cpp-vulkan')
  depends=(
    "${pkgbase}=${pkgver}-${pkgrel}"
  'vulkan-driver'
  )
  optdepends=(
  'vulkan-intel: Intel GPU acceleration'
  'vulkan-radeon: AMD GPU acceleration'
  )
  conflicts=(
  'llama-cpp-cuda12'
  'llama-cpp-cuda13'
  'llama-cpp-rocm'
  'llama-cpp-openvino'
  'llama-cpp-sycl-fp16'
  'llama-cpp-sycl-fp32'
  )
  _package_backend 'vulkan'
}

